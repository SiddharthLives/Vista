# Vista Backend Production Environment Configuration
# Copy this file to .env.production and update with your production values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Atlas connection string (recommended for production)
MONGODB_URI=mongodb+srv://prod_user:SECURE_PASSWORD@prod-cluster.mongodb.net/vista_prod?retryWrites=true&w=majority

# Connection pool settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Use a strong, random secret (minimum 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_MINIMUM_32_CHARACTERS_FOR_PRODUCTION
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# FIREBASE CONFIGURATION (Production Project)
# =============================================================================
FIREBASE_PROJECT_ID=vista-prod-12345
FIREBASE_PRIVATE_KEY_ID=your_production_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vista-prod-12345.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_production_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40vista-prod-12345.iam.gserviceaccount.com

# =============================================================================
# CLOUDINARY CONFIGURATION (Production Account)
# =============================================================================
CLOUDINARY_CLOUD_NAME=vista-prod
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER_PREFIX=vista-prod

# =============================================================================
# COLLEGE CONFIGURATION
# =============================================================================
COLLEGE_EMAIL_DOMAIN=college.edu
COLLEGE_NAME=Your College Name
COLLEGE_SHORT_NAME=YCN

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://vista-redis:6379
REDIS_PASSWORD=SECURE_REDIS_PASSWORD_HERE
REDIS_DB=0
REDIS_KEY_PREFIX=vista:prod:
REDIS_TTL=3600

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGIN=https://vista.college.edu,https://admin.vista.college.edu,https://app.vista.college.edu

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline'
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_IMG_SRC='self' data: https://res.cloudinary.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_CONNECT_SRC='self' https://api.vista.college.edu wss://api.vista.college.edu

# Security headers
HELMET_HSTS_MAX_AGE=31536000
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# API-specific rate limits
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=300000
RATE_LIMIT_POSTS_MAX=10
RATE_LIMIT_POSTS_WINDOW=3600000
RATE_LIMIT_MESSAGES_MAX=100
RATE_LIMIT_MESSAGES_WINDOW=3600000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE=/var/log/vista/app.log
LOG_ERROR_FILE=/var/log/vista/error.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Request size limits
MAX_REQUEST_SIZE=10mb
MAX_FILE_SIZE=50mb
MAX_FIELD_SIZE=2mb

# Compression
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Connection limits
MAX_CONNECTIONS=1000
KEEP_ALIVE_TIMEOUT=65000

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# SOCKET.IO CONFIGURATION
# =============================================================================
SOCKET_IO_CORS_ORIGIN=https://vista.college.edu,https://app.vista.college.edu
SOCKET_IO_TRANSPORTS=websocket,polling
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@college.edu
# SMTP_PASS=your_email_password
# EMAIL_FROM=Vista <noreply@college.edu>

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================
# NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
# NEW_RELIC_APP_NAME=Vista API Production
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_REAL_TIME_FEATURES=true
ENABLE_FILE_UPLOADS=true
ENABLE_ADMIN_FEATURES=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=vista-backups
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1